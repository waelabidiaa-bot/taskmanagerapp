<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskManager.UI.ViewModels"
        x:Class="TaskManager.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="My Workspace"
        Width="1100"
        Height="720"
        MinWidth="850"
        MinHeight="550"
        Background="#F8FAFC">

    <Grid ColumnDefinitions="210,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                        Padding="18,20,18,16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="My Workspace" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="Study, tasks &amp; notes" Classes="muted" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="8,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <Button Content="{Binding Title}"
                                    Command="{Binding SelectCommand}"
                                    Classes="nav"
                                    Classes.selected="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Selected module -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="24,20,24,20" />
    </Grid>
</Window>
