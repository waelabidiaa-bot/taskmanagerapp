<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskManager.UI.ViewModels"
        xmlns:icons="using:TaskManager.UI.Icons"
        x:Class="TaskManager.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="My Workspace"
        Width="1300"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#0F172A">

    <Grid ColumnDefinitions="56,*">

        <!-- VSCode-style activity bar: icons only, tooltips on hover. -->
        <Border Grid.Column="0"
                Background="#0B1120"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Height="56"
                        BorderBrush="#1E293B"
                        BorderThickness="0,0,0,1">
                    <PathIcon Data="{x:Static icons:AppIcons.Dashboard}"
                              Classes="rail-icon"
                              Foreground="#60A5FA"
                              ToolTip.Tip="My Workspace" />
                </Border>

                <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <Button Command="{Binding SelectCommand}"
                                    Classes="rail"
                                    Classes.selected="{Binding IsSelected}"
                                    ToolTip.Tip="{Binding Title}">
                                <PathIcon Data="{Binding Icon}" Classes="rail-icon" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Panes are added here at runtime, with draggable splitters between them. -->
        <Grid x:Name="PaneGrid" Grid.Column="1" Margin="8" />
    </Grid>
</Window>
