<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskManager.UI.ViewModels.Tasks"
             xmlns:models="using:TaskManager.Core.Models"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="TaskManager.UI.Views.Tasks.TasksView"
             x:DataType="vm:TasksViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="Tasks" Classes="page-title" />
                <TextBlock Text="Create, organize and complete your daily tasks." Classes="muted" />
            </StackPanel>

            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Task details" Classes="section-title" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Title" Classes="field-label" />
                            <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="What needs to be done?" />
                            <TextBlock Text="Description" Classes="field-label" Margin="0,6,0,0" />
                            <TextBox Text="{Binding Description, Mode=TwoWay}"
                                     PlaceholderText="Optional details"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="70" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Priority" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding Priorities}"
                                      SelectedItem="{Binding Priority, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="Due date" Classes="field-label" Margin="0,6,0,0" />
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}" />

                            <TextBlock Text="Category" Classes="field-label" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Category">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Learning activity" Classes="field-label" Margin="0,6,0,0" />
                            <ComboBox ItemsSource="{Binding LearningActivities}"
                                      SelectedItem="{Binding SelectedLearningActivity, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LearningActivity">
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Classes="error" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save task" Command="{Binding SaveTaskCommand}" Classes="primary" />
                        <Button Content="Clear" Command="{Binding ClearFormCommand}" Classes="secondary" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Text="Task list" Classes="section-title" />

                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search tasks..." />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding PriorityFilters}"
                                  SelectedItem="{Binding PriorityFilter, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Classes="muted" MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Completed" Classes="muted" IsVisible="{Binding IsFinished}" />
                                        <TextBlock Text="Pending" Classes="muted" IsVisible="{Binding !IsFinished}" />
                                        <TextBlock Text="{Binding Priority}" Classes="muted" />
                                        <TextBlock Text="{Binding DueDate}" Classes="muted" />
                                        <TextBlock Text="{Binding Category.Name}" Classes="muted" />
                                        <TextBlock Text="{Binding LearningActivity.Title}" Classes="muted" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Toggle complete" Command="{Binding ToggleCompleteCommand}" Classes="secondary" />
                        <Button Content="Open task notes" Command="{Binding OpenTaskNotesCommand}" Classes="secondary" />
                        <Button Content="Delete" Command="{Binding DeleteTaskCommand}" Classes="danger" />
                    </StackPanel>

                    <Border Background="#F8FAFC" CornerRadius="4" Padding="10"
                            IsVisible="{Binding SelectedTask, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Notes for selected task" Classes="section-title" />
                            <ListBox ItemsSource="{Binding SelectedTask.Notes}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Note">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Classes="summary" MaxLines="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
