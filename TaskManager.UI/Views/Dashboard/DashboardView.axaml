<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskManager.UI.ViewModels.Dashboard"
             xmlns:models="using:TaskManager.Core.Models"
             xmlns:icons="using:TaskManager.UI.Icons"
             x:Class="TaskManager.UI.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:CompileBindings="True">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1300" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{x:Static icons:AppIcons.Dashboard}" Classes="page-icon" Foreground="#60A5FA" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" Classes="page-title" />
                    <TextBlock Text="A quick look at your workspace." Classes="muted" />
                </StackPanel>
            </StackPanel>

            <WrapPanel ItemSpacing="12" LineSpacing="12">
                <Border Classes="metric" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalTasks}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Total tasks" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding CompletedTasks}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Completed" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" MinWidth="160">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PendingTasks}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Pending" Classes="muted" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <WrapPanel ItemSpacing="12" LineSpacing="12">
                <Border Classes="panel" MinWidth="340">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:AppIcons.Notes}" Classes="icon" Foreground="#94A3B8" />
                            <TextBlock Text="Recent notes" Classes="section-title" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding RecentNotes}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="280">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Note">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Classes="summary"
                                                   MaxLines="2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Content}" Classes="muted"
                                                   MaxLines="1" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Classes="panel" MinWidth="340">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:AppIcons.Learning}" Classes="icon" Foreground="#94A3B8" />
                            <TextBlock Text="Study goals" Classes="section-title" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LearningActivities}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="280">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LearningActivity">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Classes="muted" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" />
                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                            <TextBlock Text="{Binding Progress}" Classes="muted" />
                                            <TextBlock Text="%" Classes="muted" />
                                            <TextBlock Text="·" Classes="muted" />
                                            <TextBlock Text="{Binding CompletedMilestones}" Classes="muted" />
                                            <TextBlock Text="/" Classes="muted" />
                                            <TextBlock Text="{Binding Milestones.Count}" Classes="muted" />
                                            <TextBlock Text="milestones" Classes="muted" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
