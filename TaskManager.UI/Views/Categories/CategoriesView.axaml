<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskManager.UI.ViewModels.Categories"
             xmlns:models="using:TaskManager.Core.Models"
             xmlns:icons="using:TaskManager.UI.Icons"
             x:Class="TaskManager.UI.Views.Categories.CategoriesView"
             x:DataType="vm:CategoriesViewModel"
             x:CompileBindings="True">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" MaxWidth="1100" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{x:Static icons:AppIcons.Categories}" Classes="page-icon" Foreground="#60A5FA" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Categories" Classes="page-title" />
                    <TextBlock Text="Reusable labels for tasks and notes." Classes="muted" />
                </StackPanel>
            </StackPanel>

            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Text="Category name" Classes="field-label" />
                    <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="For example: Work, Personal, Ideas" />
                    <TextBlock Text="{Binding ErrorMessage}" Classes="error" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Button Command="{Binding SaveCategoryCommand}" Classes="primary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:AppIcons.Save}" Classes="icon" />
                                <TextBlock Text="Save category" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearFormCommand}" Classes="secondary">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:AppIcons.Clear}" Classes="icon" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{x:Static icons:AppIcons.Categories}" Classes="icon" Foreground="#94A3B8" />
                        <TextBlock Text="Your categories" Classes="section-title" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="360">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Command="{Binding DeleteCategoryCommand}" Classes="danger">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:AppIcons.Delete}" Classes="icon" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
