<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskManager.UI.ViewModels.AllTasks"
             xmlns:models="using:TaskManager.Core.Models"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:icons="using:TaskManager.UI.Icons"
             x:Class="TaskManager.UI.Views.AllTasks.AllTasksView"
             x:DataType="vm:AllTasksViewModel"
             x:CompileBindings="True">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1400" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,24">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <PathIcon Data="{x:Static icons:AppIcons.AllTasks}" Classes="page-icon" Foreground="#60A5FA" />
                <StackPanel Spacing="4">
                    <TextBlock Text="All Tasks" Classes="page-title" />
                    <TextBlock Text="Every task with its progress, notes and full details." Classes="muted" />
                </StackPanel>
            </StackPanel>

            <WrapPanel ItemSpacing="12" LineSpacing="12">
                <Border Classes="metric" MinWidth="140">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalTasks}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Total tasks" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" MinWidth="140">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding CompletedTasks}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Completed" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" MinWidth="140">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding PendingTasks}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Pending" Classes="muted" />
                    </StackPanel>
                </Border>
                <Border Classes="metric" MinWidth="140">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalNotes}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Linked notes" Classes="muted" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260" />
                    <ColumnDefinition Width="3*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Classes="panel">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{x:Static icons:AppIcons.AllTasks}" Classes="icon" Foreground="#94A3B8" />
                            <TextBlock Text="Task list" Classes="section-title" />
                        </StackPanel>

                        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search tasks or note summaries..." />
                        <ComboBox ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />

                        <ListBox ItemsSource="{Binding Tasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="520">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <StackPanel Spacing="6">
                                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="Done" Classes="badge-pin"
                                                       IsVisible="{Binding IsFinished}" />
                                            <TextBlock Text="Pending" Classes="muted"
                                                       IsVisible="{Binding !IsFinished}" />
                                        </WrapPanel>

                                        <ProgressBar Value="{Binding ProgressPercent}"
                                                     Maximum="100"
                                                     Height="6" />

                                        <WrapPanel ItemSpacing="10" LineSpacing="4">
                                            <TextBlock Text="{Binding Priority}" Classes="muted" />
                                            <TextBlock Text="{Binding DueDate}" Classes="muted" />
                                            <TextBlock Text="{Binding Category.Name}" Classes="muted" />
                                            <TextBlock Text="{Binding LearningActivity.Title}" Classes="muted" />
                                            <TextBlock Text="{Binding Notes.Count}" Classes="muted" />
                                            <TextBlock Text="notes" Classes="muted" />
                                        </WrapPanel>

                                        <ScrollViewer MaxHeight="72"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Notes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Note">
                                                        <StackPanel Spacing="1" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       Classes="summary"
                                                                       MaxLines="1"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel"
                        IsVisible="{Binding SelectedTask, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <WrapPanel ItemSpacing="10" LineSpacing="4">
                                <TextBlock Text="Task details" Classes="section-title" />
                                <TextBlock Text="Completed" Classes="badge-pin"
                                           IsVisible="{Binding SelectedTask.IsFinished}" />
                                <TextBlock Text="Pending" Classes="muted"
                                           IsVisible="{Binding !SelectedTask.IsFinished}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedTask.Title}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedTask.Description}"
                                       Classes="summary"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel ItemSpacing="16" LineSpacing="8">
                            <StackPanel Spacing="2" MinWidth="120">
                                <TextBlock Text="Priority" Classes="field-label" />
                                <TextBlock Text="{Binding SelectedTask.Priority}" Classes="summary" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="140">
                                <TextBlock Text="Due date" Classes="field-label" />
                                <TextBlock Text="{Binding SelectedTask.DueDate}" Classes="summary" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="140">
                                <TextBlock Text="Category" Classes="field-label" />
                                <TextBlock Text="{Binding SelectedTask.Category.Name}" Classes="summary" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="160">
                                <TextBlock Text="Study goal" Classes="field-label" />
                                <TextBlock Text="{Binding SelectedTask.LearningActivity.Title}" Classes="summary" />
                            </StackPanel>
                            <StackPanel Spacing="2" MinWidth="140">
                                <TextBlock Text="Created" Classes="field-label" />
                                <TextBlock Text="{Binding SelectedTask.CreatedAt}" Classes="summary" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Task completion" Classes="field-label" />
                            <ProgressBar Value="{Binding SelectedTask.ProgressPercent}"
                                         Maximum="100"
                                         Height="8" />
                            <TextBlock Classes="muted">
                                <Run Text="{Binding SelectedTask.ProgressPercent}" />
                                <Run Text="% done" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    IsVisible="{Binding SelectedTask.LearningActivity, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                            <TextBlock Text="Linked study goal progress" Classes="field-label" />
                            <ProgressBar Value="{Binding SelectedTask.LearningActivity.Progress}"
                                         Maximum="100"
                                         Height="8" />
                            <TextBlock Classes="muted">
                                <Run Text="{Binding SelectedTask.LearningActivity.Title}" />
                                <Run Text=" · " />
                                <Run Text="{Binding SelectedTask.LearningActivity.Progress}" />
                                <Run Text="% from milestones" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <WrapPanel ItemSpacing="8" LineSpacing="4">
                                <PathIcon Data="{x:Static icons:AppIcons.Notes}" Classes="icon" Foreground="#94A3B8" />
                                <TextBlock Text="Notes" Classes="section-title" />
                                <TextBlock Text="{Binding SelectedTask.Notes.Count}" Classes="muted" />
                            </WrapPanel>

                            <ScrollViewer MaxHeight="260"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedTask.Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Note">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="10"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="4">
                                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="Pinned" Classes="badge-pin"
                                                                   IsVisible="{Binding IsPinned}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Summary}" Classes="summary"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Content}" Classes="muted"
                                                               TextWrapping="Wrap" MaxLines="4" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Command="{Binding ToggleCompleteCommand}" Classes="secondary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static icons:AppIcons.Check}" Classes="icon" />
                                    <TextBlock Text="Toggle complete" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditTaskCommand}" Classes="secondary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static icons:AppIcons.Edit}" Classes="icon" />
                                    <TextBlock Text="Edit in Tasks" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenTaskNotesCommand}" Classes="primary">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{x:Static icons:AppIcons.Notes}" Classes="icon" />
                                    <TextBlock Text="Open notes" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel"
                        IsVisible="{Binding SelectedTask, Converter={x:Static converters:ObjectConverters.IsNull}}">
                    <TextBlock Text="Select a task to see its notes, progress and full details."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
